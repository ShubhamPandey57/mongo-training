<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css\bootstrap.min.css">
    <link rel="stylesheet" href="CSS2/style.css">
    <title>HOME</title>
</head>
<body>
    <%-include('partials/navbar')%>
    <%-include('partials/hero')%>
     <!-- about -->
     <section id="about" class="container py-5">
        <h2 class="mb-4 text-center">About Us</h2> 
        <div class="row g-4">
            <% about.forEach(function(item){ %>     
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm p-3 text-center">                
                <div class="card-body">
                    <h5 class="card-title mb-3"><%= item.title %></h5>              
                    <p class="card-text text-muted">
                    <%= item.description %>
                    </p>
                    <a href="#" class="btn btn-outline-dark mt-2">
                    <%= item.link %>
                    </a>
                </div>              
                </div>
            </div>
            <% }) %>
        </div>
    </section>
<!-- services -->
    <section id="service" class="container py-5">
        <h2 class="mb-4 text-center">Our Services</h2>
        <div class="row g-4">
        <% services.forEach(function(item){ %>
            <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-card">
                <img src="<%= item.image %>" class="card-img-top service-card-img" alt ="<%= item.title %>">
                <div class="card-body">
                <h5><%= item.title %></h5>
                </div>
            </div>
            </div>
        <% }) %>
        </div>
  </section>
    
    
</body>
<script src="js/bootstrap.bundle.min.js"></script>
</html>