<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
</head>

<body class="site-body">
  <%- include('partials/navbar')%>

  <main class="site-main">
  <%- include('partials/hero')%>

  <section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0">Popular Services</h2>
      <a href="/service" class="btn btn-outline-primary btn-sm">View all</a>
    </div>
    <div class="row g-4">
      <% services.forEach(function(item){ %>
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card h-100 service-card">
            <img src="<%= item.image %>" class="card-img-top service-card-img" alt="<%= item.title %>">
            <div class="card-body">
              <h5 class="card-title"><%= item.title %></h5>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0">About Us</h2>
      <a href="/about" class="btn btn-outline-secondary btn-sm">More about us</a>
    </div>
    <div class="row g-4 align-items-stretch about-layout">
      <div class="col-12 col-lg-5">
        <div class="about-media-wrap">
          <img src="/images/AboutUs.png" class="about-main-img" alt="About Us">
        </div>
      </div>
      <div class="col-12 col-lg-7">
        <div class="about-content-wrap">
          <% about.forEach(function(item){ %>
            <article class="about-item">
              <h5 class="about-item-title"><%= item.title || item.tile %></h5>
              <p class="about-item-text mb-0"><%= item.description %></p>
            </article>
          <% }) %>
          <a href="/about" class="btn btn-dark about-cta-btn">Read more about us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0">Our Team</h2>
    </div>
    <div class="row g-4">
      <% employee.slice(0, 3).forEach(function(item){ %>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="card h-100 employee-card">
            <img src="<%= item.image %>" class="card-img-top employee-img <%= /CEO|Lead Technician/i.test(item.role) ? 'full-img' : '' %>" alt="<%= item.name %>">
            <div class="card-body text-center employee-card-body">
              <h5 class="card-title employee-name mb-1"><%= item.name %></h5>
              <p class="employee-role mb-0"><%= item.role %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="row g-4 mt-1 justify-content-center">
      <% employee.slice(3).forEach(function(item){ %>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="card h-100 employee-card">
            <img src="<%= item.image %>" class="card-img-top employee-img <%= /CEO|Lead Technician/i.test(item.role) ? 'full-img' : '' %>" alt="<%= item.name %>">
            <div class="card-body text-center employee-card-body">
              <h5 class="card-title employee-name mb-1"><%= item.name %></h5>
              <p class="employee-role mb-0"><%= item.role %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0">What Our Clients Say</h2>
    </div>
    <div class="row g-4">
      <% Clients.forEach(function(item){ %>
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="card h-100">
            <img src="<%= item.image %>" class="card-img-top client-img" alt="<%= item.name %>">
            <div class="card-body">
              <p class="card-text"><%= item.feedback %></p>
              <h5 class="card-title"><%= item.name %></h5>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <%- include('partials/banner') %>
  </main>

  <footer class="site-footer">
    <%- include('partials/footer')%>
  </footer>
  
</body>
<script src="/js/bootstrap.bundle.min.js"></script>
</html>