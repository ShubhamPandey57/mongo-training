<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <!-- <link rel="stylesheet" href="/css1/style.css"> -->
   <style>
/* ===== BACKGROUND ===== */
/* ===== RESET ===== */

/* ===== BACKGROUND ===== */
.auth-section {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(120deg, #d6ccc2, #f5f5f5);
  padding: 20px;
}

/* ===== CARD ===== */
.auth-card {
  padding: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center; /* center everything */
}




/* ===== FORM SIDE ===== */

/* PUSH FORM RIGHT */
.auth-card {
  padding-left: 50%;
  padding-right: 60px;
  display: flex;
  flex-direction: column;
  justify-content: center; /* ✅ vertical center */
}

.auth-card .text-center {
  text-align: center !important;
}

.auth-card form {
  width: 100%;
  max-width: 400px;
}
/* ===== FORM STYLING ===== */
.auth-card h2 {
  font-size: 32px;
  margin-bottom: 25px;
}

.form-control {
  border-radius: 30px;
  padding: 14px 18px;
  background: #f9f9f9;
  border: 1px solid #ddd;
  text-align: center;
}

.form-control:focus {
  border-color: #ff5a2c;
  box-shadow: 0 0 0 3px rgba(255,90,44,0.2);
}

/* BUTTON */
.btn-primary {
  border-radius: 30px;
  padding: 14px;
  background: linear-gradient(90deg, #ff5a2c, #ff2e63);
  border: none;
  font-weight: 600;
}

/* LINKS */
.auth-card a {
  color: #ff5a2c;
}

/* ===== MOBILE ===== */
@media (max-width: 992px) {
  .auth-card {
    height: auto;
    padding: 40px;
    max-width: 500px;
  }


  
}
   </style>
</head>
<body class="site-body">
  <%- include('partials/navbar') %>

  <main class="site-main auth-page">
    <section class="auth-section">
      <div class="auth-overlay"></div>
      <div class="container h-100">
        <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 180px);">
          <div class="col-lg-6">
            <div class="auth-card shadow-lg">
              <h2 class="mb-4">User Login</h2>
              <form id="userLoginForm">
                <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" class="form-control" id="email" required>
                </div>
                <div class="mb-3">
                  <label for="password" class="form-label">Password</label>
                  <input type="password" class="form-control" id="password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
              </form>
              <div id="loginMessage" class="mt-3"></div>
              <div class="mt-4 text-center">
                <p class="mb-1">Don't have an account? <a href="/register">Register here</a></p>
                <p>Admin? <a href="/admin/login">Login as admin</a></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  

  <script>
    const userLoginForm = document.getElementById('userLoginForm');
    const loginMessage = document.getElementById('loginMessage');

    userLoginForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      loginMessage.textContent = '';
      loginMessage.className = '';

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      try {
        const response = await fetch('/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });

        const result = await response.json();

        if (!response.ok || result.error) {
          loginMessage.className = 'text-danger';
          loginMessage.textContent = result.error || 'Unable to login. Please try again.';
          return;
        }

        localStorage.setItem('userToken', result.token);
        localStorage.setItem('userName', result.users.fullname || 'User');

        if (result.users && result.users.role === 'admin') {
          window.location.href = '/admin/dashboard';
          return;
        }

        loginMessage.className = 'text-success';
        loginMessage.textContent = 'Login successful! Redirecting...';
        setTimeout(() => {
          window.location.href = '/';
        }, 1000);
      } catch (error) {
        loginMessage.className = 'text-danger';
        loginMessage.textContent = 'Network error while trying to login.';
      }
    });
  </script>
</body>
</html>