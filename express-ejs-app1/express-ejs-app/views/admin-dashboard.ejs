<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css1/style.css">

  <style>
/* ===== GLOBAL ===== */
body {
  margin: 0;
  font-family: "Poppins", sans-serif;
  background: #020617;
  color: #e2e8f0;
}

/* ===== LAYOUT ===== */
.dashboard-container {
  display: flex;
  min-height: 100vh;
}

/* ===== MAIN CONTENT (FIXED) ===== */
.main-content {
  flex: 1;
  padding: 30px 20px;
  background: #020617;

  /* ✅ CENTER WITHOUT FLEX BREAK */
  max-width: 1100px;
  margin-left: auto;
  margin-right: auto;
}

/* ===== FORCE VERTICAL FLOW ===== */
.dashboard-content {
  display: block;
  width: 100%;
  margin-top: 20px;
}

/* ===== HEADER ===== */
.dashboard-header {
  width: 100%;
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(12px);
  padding: 20px;
  border-radius: 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

.dashboard-header h1 {
  margin: 0;
  font-size: 22px;
}

/* ===== BUTTON ===== */
.logout-btn {
  background: linear-gradient(45deg, #ef4444, #dc2626);
  border: none;
  color: white;
  padding: 8px 14px;
  border-radius: 8px;
  cursor: pointer;
}

/* ===== CARDS ===== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.stat-card {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(10px);
  border-radius: 14px;
  padding: 25px;
  text-align: center;
  transition: 0.3s;
}

.stat-card:hover {
  transform: translateY(-6px);
}

.stat-card h3 {
  color: #94a3b8;
  font-size: 14px;
}

.stat-card .value {
  font-size: 30px;
  color: #38bdf8;
}

/* ===== TABLE ===== */
.table-container {
  margin-top: 25px;
  background: rgba(255,255,255,0.05);
  border-radius: 14px;
  padding: 20px;
  backdrop-filter: blur(10px);
  width: 100%;
}

.table-container table {
  width: 100%;
  border-collapse: collapse;
}

.table-container th {
  color: #94a3b8;
  font-size: 13px;
  padding: 12px;
}

.table-container td {
  padding: 12px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

/* ===== BUTTONS ===== */
.action-btn {
  padding: 6px 12px;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  font-size: 12px;
}

.edit-btn {
  background: #3b82f6;
  color: white;
}

.delete-btn {
  background: #ef4444;
  color: white;
}

/* ===== FORM ===== */
.form-section {
  margin-top: 20px;
  background: rgba(255,255,255,0.05);
  padding: 25px;
  border-radius: 14px;
  backdrop-filter: blur(10px);
  width: 100%;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.05);
  color: white;
}

.form-group input:focus,
.form-group select:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 8px rgba(99,102,241,0.4);
}

/* ===== SUBMIT BUTTON ===== */
.submit-btn {
  background: linear-gradient(45deg, #22c55e, #16a34a);
  border: none;
  color: white;
  padding: 10px 16px;
  border-radius: 8px;
  cursor: pointer;
}

/* ===== MESSAGE ===== */
.message {
  margin-top: 10px;
  padding: 10px;
  border-radius: 6px;
}

.message.success {
  background: rgba(34,197,94,0.1);
  color: #22c55e;
}

.message.error {
  background: rgba(239,68,68,0.1);
  color: #ef4444;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .main-content {
    max-width: 100%;
    padding: 20px;
  }

  .dashboard-header {
    flex-direction: column;
    gap: 10px;
  }
}
  </style>
</head>

<body>
  <div class="dashboard-container">

    <!-- Main Content -->
    <div class="main-content">

      <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <div class="user-info">
          <button class="logout-btn" onclick="logoutAdmin()">Logout</button>
        </div>
      </div>

      <div id="message" class="message"></div>

      <!-- Overview -->
      <div id="overview" class="dashboard-content active">
        <div class="stats-grid">
          <div class="stat-card">
            <h3>Total Users</h3>
            <div class="value" id="totalUsers">0</div>
          </div>
          <div class="stat-card">
            <h3>Admin Accounts</h3>
            <div class="value" id="totalAdmins">1</div>
          </div>
          <div class="stat-card">
            <h3>Regular Users</h3>
            <div class="value" id="totalRegularUsers">0</div>
          </div>
          <div class="stat-card">
            <h3>System Status</h3>
            <div class="value" style="color:#22c55e;">Active</div>
          </div>
        </div>

        <div class="table-container">
          <h3>Recent Users</h3>
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
              </tr>
            </thead>
            <tbody id="recentUsersTable">
              <tr>
                <td colspan="4" style="text-align:center;color:#7f8c8d;">No users yet</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Users -->
      <div id="users" class="dashboard-content">
        <div class="table-container">
          <h2>Manage Users</h2>
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="usersTable">
              <tr>
                <td colspan="5" style="text-align:center;color:#7f8c8d;">Loading users...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Services -->
      <div id="services" class="dashboard-content">
        <div class="table-container">
          <h2>Manage Services</h2>
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Price</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="servicesTable">
              <tr>
                <td colspan="6" style="text-align:center;color:#7f8c8d;">Loading services...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Orders -->
      <div id="orders" class="dashboard-content">
        <div class="table-container">
          <h2>Service Requests</h2>
          <table>
            <thead>
              <tr>
                <th>User</th>
                <th>Email</th>
                <th>Items</th>
                <th>Total Time</th>
                <th>Total Cost</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="ordersTable">
              <tr>
                <td colspan="7" style="text-align:center;color:#7f8c8d;">Loading requests...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Service -->
      <div id="addservice" class="dashboard-content">
        <div class="form-section">
          <h2>Add New Service</h2>
          <form id="addServiceForm">
            <div class="form-group">
              <label>Service Title *</label>
              <input type="text" id="serviceTitle" required>
            </div>
            <div class="form-group">
              <label>Description</label>
              <input type="text" id="serviceDescription">
            </div>
            <div class="form-group">
              <label>Image URL</label>
              <input type="text" id="serviceImage">
            </div>
            <div class="form-group">
              <label>Price *</label>
              <input type="number" id="servicePrice" required>
            </div>
            <div class="form-group">
              <label>Duration *</label>
              <input type="text" id="serviceDuration" required>
            </div>
            <button type="submit" class="submit-btn">Add Service</button>
          </form>
        </div>
      </div>

    </div>
  </div>

  <script src="/js/bootstrap.bundle.min.js"></script>
  <script>
    // Initialize dashboard
    document.addEventListener('DOMContentLoaded', () => {
      // Display admin name
      const adminName = localStorage.getItem('adminName') || 'Admin';
      document.getElementById('adminName').textContent = adminName;
      
      loadDashboardData();
      loadUsers();
      loadServices();
    });

    // Show/Hide sections
    function showSection(sectionId, element) {
      // Hide all sections
      document.querySelectorAll('.dashboard-content').forEach(section => {
        section.classList.remove('active');
      });

      // Remove active class from all menu items
      document.querySelectorAll('.sidebar-menu li').forEach(item => {
        item.classList.remove('active');
      });

      // Show selected section
      document.getElementById(sectionId).classList.add('active');
      element.classList.add('active');

      if (sectionId === 'orders' && typeof loadOrders === 'function') {
        loadOrders();
      }
    }

    // Get auth headers for secured admin API calls
    function getAuthHeaders() {
      const token = localStorage.getItem('adminToken');
      if (!token) {
        window.location.href = '/admin/login';
        return { 'Content-Type': 'application/json' };
      }
      return {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`
      };
    }

    // Load dashboard data
    async function loadDashboardData() {
      try {
        const response = await fetch('/dashboard-stats', {
          headers: getAuthHeaders()
        });
        if (response.ok) {
          const data = await response.json();
          document.getElementById('totalUsers').textContent = data.totalUsers || 0;
          document.getElementById('totalAdmins').textContent = data.totalAdmins || 1;
          document.getElementById('totalRegularUsers').textContent = data.totalRegularUsers || 0;

          // Load recent users
          if (data.recentUsers && data.recentUsers.length > 0) {
            const tbody = document.getElementById('recentUsersTable');
            tbody.innerHTML = data.recentUsers.map(user => `
              <tr>
                <td>${user.fullname}</td>
                <td>${user.email}</td>
                <td><span style="background-color: ${user.role === 'admin' ? '#3498db' : '#95a5a6'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">${user.role}</span></td>
                <td>${new Date(user.createdAt).toLocaleDateString()}</td>
              </tr>
            `).join('');
          }
        }
      } catch (error) {
        console.error('Error loading dashboard data:', error);
      }
    }

    // Load users
    async function loadUsers() {
      try {
        const response = await fetch('/all-users', {
          headers: getAuthHeaders()
        });
        if (response.ok) {
          const data = await response.json();
          const tbody = document.getElementById('usersTable');
          
          if (data.users && data.users.length > 0) {
            tbody.innerHTML = data.users.map(user => `
              <tr>
                <td>${user.fullname}</td>
                <td>${user.email}</td>
                <td><span style="background-color: ${user.role === 'admin' ? '#3498db' : '#95a5a6'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">${user.role}</span></td>
                <td>${new Date(user.createdAt).toLocaleDateString()}</td>
                <td>
                  <button class="action-btn edit-btn" onclick="editUser('${user._id}')">Edit</button>
                  <button class="action-btn delete-btn" onclick="deleteUser('${user._id}')">Delete</button>
                </td>
              </tr>
            `).join('');
          } else {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #7f8c8d;">No users found</td></tr>';
          }
        }
      } catch (error) {
        console.error('Error loading users:', error);
      }
    }

    // Add user form submission
    document.getElementById('addUserForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const fullname = document.getElementById('fullname').value;
      const email = document.getElementById('newemail').value;
      const password = document.getElementById('newpassword').value;
      const role = document.getElementById('newrole').value;

      try {
        const response = await fetch('/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullname, email, password, role })
        });

        const result = await response.json();
        const msgEl = document.getElementById('message');

        if (response.ok && result.user) {
          msgEl.className = 'message success';
          msgEl.textContent = 'User added successfully!';
          document.getElementById('addUserForm').reset();
          loadUsers();
          setTimeout(() => msgEl.className = 'message', 3000);
        } else {
          msgEl.className = 'message error';
          msgEl.textContent = result.message || 'Error adding user';
          setTimeout(() => msgEl.className = 'message', 3000);
        }
      } catch (error) {
        const msgEl = document.getElementById('message');
        msgEl.className = 'message error';
        msgEl.textContent = 'Error communicating with server';
        setTimeout(() => msgEl.className = 'message', 3000);
      }
    });

    // Delete user
    function deleteUser(userId) {
      if (confirm('Are you sure you want to delete this user?')) {
        alert('Delete functionality will be implemented in the next update');
        // Implementation for delete will be added
      }
    }

    // Edit user
    function editUser(userId) {
      alert('Edit functionality will be implemented in the next update');
      // Implementation for edit will be added
    }

    // Logout
    function logoutAdmin() {
      if (confirm('Are you sure you want to logout?')) {
        fetch('/logout', { method: 'GET' })
          .then(() => {
            window.location.href = '/admin/login';
          })
          .catch(error => console.error('Logout error:', error));
      }
    }

    // Load Services
    async function loadServices() {
      try {
        const response = await fetch('/services', {
          headers: getAuthHeaders()
        });
        if (response.ok) {
          const data = await response.json();
          const tbody = document.getElementById('servicesTable');
          
          if (data.services && data.services.length > 0) {
            tbody.innerHTML = data.services.map(service => `
              <tr>
                <td>${service.title}</td>
                <td>${service.description || 'N/A'}</td>
                <td>$${service.price.toFixed(2)}</td>
                <td>${service.duration}</td>
                <td><span style="background-color: ${service.status === 'active' ? '#27ae60' : '#95a5a6'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">${service.status}</span></td>
                <td>
                  <button class="action-btn edit-btn" onclick="editService('${service._id}')">Edit</button>
                  <button class="action-btn delete-btn" onclick="deleteService('${service._id}')">Delete</button>
                </td>
              </tr>
            `).join('');
          } else {
            tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #7f8c8d;">No services found</td></tr>';
          }
        }
      } catch (error) {
        console.error('Error loading services:', error);
      }
    }

    // Load Orders
    async function loadOrders() {
      try {
        const response = await fetch('/orders', {
          headers: getAuthHeaders()
        });
        const tbody = document.getElementById('ordersTable');
        if (response.ok) {
          const data = await response.json();
          if (data.orders && data.orders.length > 0) {
            tbody.innerHTML = data.orders.map(order => {
              const canDelete = order.status === 'completed' || order.status === 'cancelled';
              return `
                <tr>
                  <td>${order.userName}</td>
                  <td>${order.userEmail}</td>
                  <td>${order.items.map(item => `<div>${item.title} - ${item.duration} - $${item.price.toFixed(2)}</div>`).join('')}</td>
                  <td>${order.totalTime}</td>
                  <td>$${order.totalCost.toFixed(2)}</td>
                  <td><span style="background-color: ${order.status === 'completed' ? '#27ae60' : order.status === 'in progress' ? '#f39c12' : order.status === 'cancelled' ? '#e74c3c' : '#3498db'}; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;">${order.status}</span></td>
                  <td>
                    <select onchange="updateOrderStatus('${order._id}', this.value)" style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #bdc3c7; margin-bottom: 8px;">
                      <option value="pending" ${order.status === 'pending' ? 'selected' : ''}>Pending</option>
                      <option value="in progress" ${order.status === 'in progress' ? 'selected' : ''}>In Progress</option>
                      <option value="completed" ${order.status === 'completed' ? 'selected' : ''}>Completed</option>
                      <option value="cancelled" ${order.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
                    </select>
                    ${canDelete ? `<button onclick="deleteOrder('${order._id}', '${order.userName}')" style="width: 100%; padding: 6px; background-color: #e74c3c; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; font-weight: 600; transition: background 0.3s;">🗑️ Delete Request</button>` : ''}
                  </td>
                </tr>
              `;
            }).join('');
          } else {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #7f8c8d;">No service requests found</td></tr>';
          }
        } else {
          tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #7f8c8d;">Unable to load service requests</td></tr>';
        }
      } catch (error) {
        console.error('Error loading orders:', error);
      }
    }

    async function updateOrderStatus(orderId, status) {
      try {
        const response = await fetch(`/orders/${orderId}`, {
          method: 'PUT',
          headers: getAuthHeaders(),
          body: JSON.stringify({ status })
        });
        const result = await response.json();
        const msgEl = document.getElementById('message');
        if (response.ok) {
          msgEl.className = 'message success';
          msgEl.textContent = result.message || 'Order status updated';
          loadOrders();
        } else {
          msgEl.className = 'message error';
          msgEl.textContent = result.message || 'Failed to update order status';
        }
        setTimeout(() => msgEl.className = 'message', 3000);
      } catch (error) {
        console.error('Error updating order status:', error);
      }
    }

    async function deleteOrder(orderId, userName) {
      if (!confirm(`Are you sure you want to delete this service request from ${userName}? This action cannot be undone.`)) {
        return;
      }

      try {
        const response = await fetch(`/orders/${orderId}`, {
          method: 'DELETE',
          headers: getAuthHeaders()
        });
        const result = await response.json();
        const msgEl = document.getElementById('message');
        
        if (response.ok) {
          msgEl.className = 'message success';
          msgEl.textContent = '✅ ' + (result.message || 'Service request deleted successfully');
          loadOrders(); // Reload the table
        } else {
          msgEl.className = 'message error';
          msgEl.textContent = '❌ ' + (result.message || 'Failed to delete service request');
        }
        setTimeout(() => msgEl.className = 'message', 4000);
      } catch (error) {
        const msgEl = document.getElementById('message');
        msgEl.className = 'message error';
        msgEl.textContent = '❌ Error deleting service request: ' + error.message;
        setTimeout(() => msgEl.className = 'message', 4000);
        console.error('Error deleting order:', error);
      }
    }

document.getElementById('addServiceForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const msgEl = document.getElementById('message');
    const formData = {
        title: document.getElementById('serviceTitle').value,
        description: document.getElementById('serviceDescription').value,
        image: document.getElementById('serviceImage').value,
        price: parseFloat(document.getElementById('servicePrice').value),
        duration: document.getElementById('serviceDuration').value
    };

    try {
        const response = await fetch('/services', {
            method: 'POST',
            headers: getAuthHeaders(),
            body: JSON.stringify(formData)
        });

        const contentType = response.headers.get("content-type");
        let result = {};

        // Parse JSON only if it's actually JSON
        if (contentType && contentType.includes("application/json")) {
            result = await response.json();
        } else {
            const textError = await response.text();
            console.error("Server returned non-JSON:", textError);
            throw new Error("Invalid server response format");
        }

        if (response.ok) {
            msgEl.className = 'message success';
            msgEl.textContent = 'Service added successfully!';
            document.getElementById('addServiceForm').reset();
            if (typeof loadServices === 'function') loadServices(); // Refresh list
        } else {
            msgEl.className = 'message error';
            msgEl.textContent = result.message || 'Error adding service';
        }

    } catch (error) {
        console.error("Submission Error:", error);
        msgEl.className = 'message error';
        msgEl.textContent = 'Error communicating with server';
    } finally {
        // Auto-hide message after 3 seconds
        setTimeout(() => {
            msgEl.className = 'message';
            msgEl.textContent = '';
        }, 3000);
    }
});
    // Delete Service
    function deleteService(serviceId) {
      if (confirm('Are you sure you want to delete this service?')) {
        fetch(`/services/${serviceId}`, {
          method: 'DELETE',
          headers: getAuthHeaders()
        })
        .then(response => response.json())
        .then(result => {
          const msgEl = document.getElementById('message');
          if (result.message) {
            msgEl.className = 'message success';
            msgEl.textContent = 'Service deleted successfully!';
            loadServices();
          } else {
            msgEl.className = 'message error';
            msgEl.textContent = 'Error deleting service';
          }
          setTimeout(() => msgEl.className = 'message', 3000);
        })
        .catch(error => {
          const msgEl = document.getElementById('message');
          msgEl.className = 'message error';
          msgEl.textContent = 'Error deleting service';
          setTimeout(() => msgEl.className = 'message', 3000);
        });
      }
    }

    // Edit Service
    function editService(serviceId) {
      alert('Edit functionality will be implemented in the next update');
      // Implementation for edit will be added
    }
  </script>
</body>

</html>
